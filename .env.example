# Banco de dados Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# NextAuth.js v5 — gere com: openssl rand -base64 32
AUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# Criptografia AES-256 para credenciais de gateway — gere com: openssl rand -hex 32
# Gere uma chave local com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS"

# Chave Pix do SaaS (para receber assinaturas dos lojistas)
SAAS_PIX_KEY="sua-chave-pix-aqui"
SAAS_PIX_KEY_TYPE="cnpj"

# Gateway para ambiente local de teste. Use o Access Token de teste (prefixo APP_USR)
# A página/rotas de teste só funcionam fora de produção.
PAYMENTS_TEST_ENABLED="false"

# Segredo Bearer usado pelo agendador; configure um valor aleatório forte fora do repositório.
CRON_SECRET=""

# Chave secreta exibida na configuração de Webhooks do app Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=""

# Conta recebedora das mensalidades Montante (separada das contas dos lojistas).
MERCADO_PAGO_ACCESS_TOKEN=""
SAAS_BILLING_URL=""
SAAS_MERCADOPAGO_WEBHOOK_SECRET=""

# IA Montante — somente servidor. Nunca use prefixo NEXT_PUBLIC_ para a chave.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
